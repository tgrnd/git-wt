#!/bin/sh
# git-wt: `git worktree add` that never nests a worktree inside a checkout.
#
# A worktree created inside the repo (e.g. <repo>/.claude/worktrees/x or <repo>/wt/x),
# or inside one of its linked worktrees, is moved out of the checkout, so tools that
# walk up the tree (Node module resolution, workspace detection, config lookup) never
# see an outer checkout. Paths outside every checkout pass through unchanged.
#
# By default it goes to <dir>/.worktrees/<repo>/<path relative to that checkout>, where
# <dir> holds the repo. A repo inside another checkout (a submodule, or a nested clone)
# uses the folder holding the outermost checkout, and <repo> becomes its path from
# there with / as + (super+libs+sub). With GIT_WT_HOME set it goes to
# $GIT_WT_HOME/<repo>-<hash>/<path> instead.
#
# Usage:
#   git wt add [<git worktree add options>] <path> [<commit-ish>]
#   git wt path <path>        print where <path> would be remapped to
#
# Env:
#   GIT_WT_HOME    one base folder for every repo's remapped worktrees
#   GIT_WT_REMAP   set to 0 to pass every path through unchanged
set -eu

die() { printf 'git-wt: %s\n' "$*" >&2; exit 1; }
log() { printf 'git-wt: %s\n' "$*" >&2; }

usage() {
	cat >&2 <<-EOF
	usage: git wt add [<git worktree add options>] <path> [<commit-ish>]
	       git wt path <path>
	EOF
	exit 2
}

# Absolute, symlink-resolved form of $1, which need not exist yet: resolve the
# deepest existing ancestor with `pwd -P` and append the rest lexically.
resolve() {
	case $1 in /*) p=$1 ;; *) p=$PWD/$1 ;; esac
	rest=
	while [ ! -d "$p" ]; do
		rest=/$(basename "$p")$rest
		p=$(dirname "$p")
	done
	printf '%s%s\n' "$(cd "$p" && pwd -P)" "$rest"
}

# Main checkout root, also when run from inside a linked worktree.
main_root() {
	common=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) ||
		die "not inside a git repository: $PWD"
	if [ "$(basename "$common")" = .git ]; then
		(cd "$(dirname "$common")" && pwd -P)
		return
	fi
	# A submodule's git dir sits in the superproject's .git/modules, and its
	# core.worktree points back at the checkout. A bare repo has no checkout.
	checkout=$(git --git-dir="$common" rev-parse --show-toplevel 2>/dev/null) ||
		die "bare repositories are not supported: $common"
	(cd "$checkout" && pwd -P)
}

# The outermost checkout holding checkout $1: $1 itself unless it sits inside
# another repo's working tree (a submodule, or a clone inside a clone).
outermost() {
	top=$1
	while [ "$top" != / ]; do
		outer=$(
			unset GIT_DIR GIT_WORK_TREE GIT_COMMON_DIR
			cd "$(dirname "$top")" && git rev-parse --show-toplevel 2>/dev/null
		) || break
		outer=$(cd "$outer" && pwd -P)
		[ "$outer" != "$top" ] || break
		top=$outer
	done
	printf '%s\n' "$top"
}

# The checkout containing $1 (main checkout or any linked worktree), or nothing.
containing_checkout() {
	git worktree list --porcelain | sed -n 's/^worktree //p' | while IFS= read -r wt; do
		[ -d "$wt" ] || continue
		wt=$(cd "$wt" && pwd -P)
		case $1 in "$wt"/*)
			printf '%s\n' "$wt"
			break
			;;
		esac
	done
}

# Print the remapped location for worktree path $1.
remap() {
	target=$(resolve "$1")
	case $target in *'/../'* | *'/..' | *'/./'* | *'/.') die "path must not contain . or .. segments: $1" ;; esac
	if [ "${GIT_WT_REMAP:-1}" = 0 ]; then
		printf '%s\n' "$target"
		return
	fi
	root=$(main_root)
	# In a submodule, `git worktree list` may name the main worktree by its git
	# dir (.git/modules/<path>), so check the main root directly.
	case $target in
	"$root"/*) checkout=$root ;;
	*) checkout=$(containing_checkout "$target") ;;
	esac
	if [ -z "$checkout" ]; then
		printf '%s\n' "$target"
		return
	fi
	rel=${target#"$checkout"/}
	rel=${rel#.claude/worktrees/}
	if [ -n "${GIT_WT_HOME:-}" ]; then
		hash=$(printf '%s' "$root" | shasum | cut -c1-8)
		printf '%s/%s-%s/%s\n' "$GIT_WT_HOME" "$(basename "$root")" "$hash" "$rel"
		return
	fi
	base=$(dirname "$(outermost "$root")")
	base=${base%/}
	bucket=$(printf '%s' "${root#"$base"/}" | tr / +)
	printf '%s/.worktrees/%s/%s\n' "$base" "$bucket" "$rel"
}

cmd_add() {
	# Find the <path> operand: the first non-option argument. Options that take a
	# separate value must skip it, or the value would be mistaken for the path.
	n=0 index=0 skip=0 opts_done=0
	for arg do
		n=$((n + 1))
		if [ "$skip" = 1 ]; then
			skip=0
			continue
		fi
		if [ "$opts_done" = 0 ]; then
			case $arg in
			--) opts_done=1; continue ;;
			-b | -B | --reason) skip=1; continue ;;
			-?*) continue ;;
			esac
		fi
		index=$n
		break
	done
	[ "$index" -gt 0 ] || usage

	# Rebuild "$@" with the path operand replaced.
	n=0
	for arg do
		n=$((n + 1))
		if [ "$n" = "$index" ]; then
			dest=$(remap "$arg")
			[ "$dest" = "$(resolve "$arg")" ] || log "remapped $arg -> $dest"
			mkdir -p "$(dirname "$dest")" ||
				die "cannot create $(dirname "$dest"); set GIT_WT_HOME to a writable folder"
			arg=$dest
		fi
		set -- "$@" "$arg"
	done
	shift "$n"
	exec git worktree add "$@"
}

[ $# -ge 1 ] || usage
sub=$1
shift
case $sub in
add) cmd_add "$@" ;;
path)
	[ $# -eq 1 ] || usage
	remap "$1"
	;;
*) usage ;;
esac
