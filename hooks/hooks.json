{
  "description": "Send git worktree add in Bash tool calls through git wt add",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}\"/claude-rewrite-worktree-add.sh", "timeout": 10 }
        ]
      }
    ]
  }
}
